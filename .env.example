# Copy to .env.local and fill in. Never commit real credentials.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="mathology"
# Optional: use these DNS resolvers if Node can't resolve mongodb+srv:// on your network (common on Windows)
# MONGODB_DNS_SERVERS="8.8.8.8,1.1.1.1"
# Comma-separated emails that get the teacher role on registration (can open every student's report)
MATHOLOGY_TEACHER_EMAILS=""
# Timezone used for day boundaries in reports
# REPORT_TIMEZONE="Asia/Kolkata"
