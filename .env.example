# Copy to .env.local and fill in. Never commit real credentials.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="mathology"
# Optional: use these DNS resolvers if Node can't resolve mongodb+srv:// on your network (common on Windows)
# MONGODB_DNS_SERVERS="8.8.8.8,1.1.1.1"
# Comma-separated emails that get the teacher role on registration (can open every student's report)
MATHOLOGY_TEACHER_EMAILS=""
# Timezone used for day boundaries in reports
# REPORT_TIMEZONE="Asia/Kolkata"

# BotBiz WhatsApp: demo-class booking confirmation (template "Dear #!name!# … #!date!# at #!time!#")
BOTBIZ_API_TOKEN=""
BOTBIZ_PHONE_NUMBER_ID=""
# The template ID from BotBiz (not the template name)
BOTBIZ_TEMPLATE_DEMO_CONFIRMATION=""
# Optional: comma-separated numbers that get a copy of each confirmation, e.g. "9876543210"
WHATSAPP_DEMO_CC_NUMBERS=""
